const RestaurantDetailScreen = () => {
    // Helper function for image section
    const imageSection = () => (
        <View style={styles.imageSliderContainer}>
            <FlatList data={imageUrls} ... />
            <View style={styles.paginationContainer}>...</View>
        </View>
    );
    
    // Helper function for main info section
    const mainInfoSection = () => (
        <View style={styles.restaurantInfoSection}>
            <Text style={styles.restaurantName}>{restaurantName}</Text>
            ...
        </View>
    );
    
    return (
        <View style={styles.container}>
            {imageSection()}
            <ScrollView>
                {mainInfoSection()}
                {corkageInfoSection()}
                {businessInfoSection()}
                {commentSection()}
            </ScrollView>
        </View>
    );
};
